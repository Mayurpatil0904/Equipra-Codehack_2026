# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/equipra_db"

# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Device API Keys ────────────────────────────────────────────
# Used to encrypt device API keys at rest so they can be viewed again later.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to JWT_SECRET if unset — set a dedicated one in production.
DEVICE_KEY_SECRET=your_device_key_encryption_secret_change_this_in_production

# ─── CORS ─────────────────────────────────────────────────────
# Frontend URL (Vite default)
CLIENT_URL=http://localhost:5173

# ─── Email (Nodemailer) ────────────────────────────────────────
# For development: use Mailtrap (https://mailtrap.io) — free inbox
# For production: use Gmail, SendGrid, etc.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
EMAIL_FROM="Equipra Platform <noreply@equipra.edu>"

# ─── File Uploads ─────────────────────────────────────────────
# Max upload size in bytes (5MB default)
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# ─── AI (Groq — FREE) ─────────────────────────────────────────
# Powers lab analytics insights and competition discovery
# Ultra-fast inference with Llama 3.3 70B — completely free
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
