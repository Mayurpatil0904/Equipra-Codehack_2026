{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",

    "lib": ["ES2020"],

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": false,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true
  },

  "include": [
    "src/server.ts",
    "src/app.ts",
    "src/controllers/**/*",
    "src/routes/**/*",
    "src/middleware/**/*",
    "src/lib/email.ts",
    "src/lib/jwt.ts",
    "src/lib/prisma.ts",
    "src/lib/response.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "src/lib/api-client.ts"
  ]
}
